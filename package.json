{
  "name": "potente-propiedades",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-sitemap.mjs && vite build && npm run build:server",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "sembrar": "tsx scripts/sembrar-db.ts",
    "verificar-db": "tsx scripts/verificar-db.ts",
    "verificar-pin": "tsx scripts/verificar-pin.ts",
    "cerrar-puerta": "node scripts/cerrar-puerta.mjs",
    "respaldo": "tsx scripts/respaldo.ts",
    "verificar-sol": "tsx scripts/verificar-sol.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=server/index.mjs",
    "server:dev": "tsx server/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.0",
    "@supabase/supabase-js": "^2.108.2",
    "@types/leaflet": "^1.9.22",
    "@types/suncalc": "^1.9.2",
    "express": "^4.21.2",
    "gsap": "^3.12.5",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "leaflet-shadow-simulator": "^0.67.0",
    "lenis": "^1.1.13",
    "lucide-react": "^0.454.0",
    "osmtogeojson": "^3.0.0-beta.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.13.0",
    "suncalc": "^2.0.1",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.21.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
